# Generate a unique high-entropy value for this project.
UPLOAD_TOKEN_PEPPER=[REDACTED]

# Exact public origin, with no trailing slash.
ALLOWED_ORIGIN=https://sihlenye.github.io

# Required before opening public intake widely.
TURNSTILE_SECRET_KEY=[REDACTED]
